{
  "version": 2,
  "installCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && npm install",
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "pubmanager/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "pubmanager/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "pubmanager/wsgi.py"
    }
  ]
}
